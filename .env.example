# Required Foundry runtime settings
FINANCE_AGENT_MODE=foundry
AZURE_AI_PROJECT_ENDPOINT=https://<project-name>.<region>.api.azureml.ms
AZURE_AI_MODEL_DEPLOYMENT=gpt-5.4

# Azure service settings
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=finance-knowledge
AZURE_STORAGE_ACCOUNT=<storage-account-name>
APPLICATIONINSIGHTS_CONNECTION_STRING=<from-deployment-output>

# Optional application settings
FINANCE_DATA_DIR=./sample-data
FINANCE_DEFAULT_APPROVER=approver@example.com
FINANCE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FINANCE_ENABLE_WRITE_ACTIONS=false
